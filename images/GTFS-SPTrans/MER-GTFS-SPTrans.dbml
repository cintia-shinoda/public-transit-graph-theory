// =============================================================
//              Diagrama ER do GTFS da SPTrans
// Para uso em dbdiagram.io (https://dbdiagram.io)
// =============================================================


Project gtfs_sptrans {
  database_type: 'GTFS'
  Note: 'Estrutura do feed GTFS estático da SPTrans'
}

// ---------- Entidades centrais ----------

Table agency {
  agency_id        int      [pk]
  agency_name      varchar
  agency_url       varchar
  agency_timezone  varchar
  agency_lang      varchar
}

Table routes {
  route_id          varchar [pk]
  agency_id         int     [ref: > agency.agency_id]
  route_short_name  varchar
  route_long_name   varchar
  route_type        int
  route_color       varchar
  route_text_color  varchar
}

Table trips {
  trip_id        varchar [pk]
  route_id       varchar [ref: > routes.route_id]
  service_id     varchar [ref: > calendar.service_id]
  shape_id       varchar
  trip_headsign  varchar
  direction_id   int
}

Table stops {
  stop_id    int     [pk]
  stop_name  varchar
  stop_desc  varchar
  stop_lat   float
  stop_lon   float
}

Table stop_times {
  trip_id         varchar [pk, ref: > trips.trip_id]
  stop_sequence   int     [pk]
  stop_id         int     [ref: > stops.stop_id]
  arrival_time    varchar
  departure_time  varchar
}

// ---------- Temporal ----------

Table calendar {
  service_id  varchar [pk]
  monday      int
  tuesday     int
  wednesday   int
  thursday    int
  friday      int
  saturday    int
  sunday      int
  start_date  int
  end_date    int
}

Table frequencies {
  trip_id       varchar [pk, ref: > trips.trip_id]
  start_time    varchar [pk]
  end_time      varchar
  headway_secs  int
  headway_min   float
  hora          int
}

// ---------- Geometria ----------

Table shapes {
  shape_id             int   [pk]
  shape_pt_sequence    int   [pk]
  shape_pt_lat         float
  shape_pt_lon         float
  shape_dist_traveled  float
}

// ---------- Tarifário ----------

Table fare_attributes {
  fare_id            varchar [pk]
  price              float
  currency_type      varchar
  payment_method     int
  transfers          int
  transfer_duration  float
}

Table fare_rules {
  fare_id         varchar [ref: > fare_attributes.fare_id]
  route_id        varchar [ref: > routes.route_id]
  origin_id       float
  destination_id  float
  contains_id     float
}

// ---------- Relacionamento opcional shapes <-> trips ----------
// shape_id em trips referencia shapes (mas é um-para-muitos com sequence)
Ref: trips.shape_id > shapes.shape_id
